{
    "openapi": "3.0.3",
    "info": {
        "title": "iGovTT AI Tools",
        "version": "1.0.0",
        "description": "Tools used by tawk.to AI Assist to retrieve iGovTT services and create appointment links."
    },
    "servers": [
        {
            "url": "https://tawkto-eapp.onrender.com"
        }
    ],
    "paths": {
        "/api/catalog/services": {
            "get": {
                "operationId": "listServices",
                "summary": "List iGovTT appointment services",
                "description": "Always use this tool when a visitor asks to list services, asks what appointment services are available, asks what services can be booked, or asks for available iGovTT services. Do not answer from general knowledge. Only answer using the services returned by this API.",
                "responses": {
                    "200": {
                        "description": "List of available appointment services",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "question": {
                                            "type": "string"
                                        },
                                        "services": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/appointment-deeplink": {
            "post": {
                "operationId": "createAppointmentDeepLink",
                "summary": "Create an appointment deeplink",
                "description": "Call this tool only after the visitor has selected a service, a branch and a date (from listAvailableDates), and has explicitly confirmed they want to book that service at that branch on that date. If listAvailableTimeSlots returned a non-empty timeSlots array, also require the visitor to pick one of those times first and pass it as selectedTime. If timeSlots was empty, do not ask the visitor to pick an exact time (this API cannot offer individual times for that case) — just confirm the date and call this tool without selectedTime; the visitor will choose their exact time on the booking page linked by appointmentUrl. Never call this tool before the required values for the case you're in are known and confirmed. After the tool returns, reply with the appointmentUrl.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "serviceId",
                                    "branchId",
                                    "selectedDate"
                                ],
                                "properties": {
                                    "serviceId": {
                                        "type": "string",
                                        "description": "The numeric service ID supplied by the visitor. Use the exact value given by the visitor."
                                    },
                                    "branchId": {
                                        "type": "string",
                                        "description": "The numeric branch ID supplied by the visitor. Use the exact value given by the visitor."
                                    },
                                    "selectedDate": {
                                        "type": "string",
                                        "format": "date",
                                        "description": "The date value returned by listAvailableDates, in YYYY-MM-DD format."
                                    },
                                    "selectedTime": {
                                        "type": "string",
                                        "description": "Optional. Only include this if listAvailableTimeSlots returned a non-empty timeSlots array and the visitor picked one — pass its value. Omit entirely if timeSlots was empty."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Appointment link created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "appointmentUrl": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/branches": {
            "post": {
                "operationId": "listBranches",
                "summary": "List branches for a selected appointment service",
                "description": "Call this tool immediately after the visitor chooses a service from listServices. Use the id associated with the selected service name. For example, if the visitor selects RGD Test and listServices returned an object with name RGD Test and id 47, call this tool with serviceId 47. Never ask the visitor for a service ID. After this tool returns, show every branch name and address from the branches array.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "serviceId"
                                ],
                                "properties": {
                                    "serviceId": {
                                        "type": "string",
                                        "description": "The id of the service selected by the visitor. Obtain this by matching the visitor's service name to the results from listServices. Never ask the visitor to provide this ID."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Branches available for the selected service",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "question": {
                                            "type": "string"
                                        },
                                        "serviceId": {
                                            "type": "string"
                                        },
                                        "branches": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "address": {
                                                        "type": "string",
                                                        "nullable": true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/available-dates": {
            "post": {
                "operationId": "listAvailableDates",
                "summary": "List available appointment dates",
                "description": "Use this tool after the visitor selects a service and branch. Pass the selected serviceId and branchId. Show the date labels to the visitor, but retain the date value in YYYY-MM-DD format for the next tool call.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "serviceId",
                                    "branchId"
                                ],
                                "properties": {
                                    "serviceId": {
                                        "type": "string",
                                        "description": "The service ID returned by listServices."
                                    },
                                    "branchId": {
                                        "type": "string",
                                        "description": "The branch ID returned by listBranches."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Available dates for the selected service and branch",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "question": {
                                            "type": "string"
                                        },
                                        "serviceId": {
                                            "type": "string"
                                        },
                                        "branchId": {
                                            "type": "string"
                                        },
                                        "dates": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "label": {
                                                        "type": "string"
                                                    },
                                                    "value": {
                                                        "type": "string",
                                                        "format": "date"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/catalog/available-time-slots": {
            "post": {
                "operationId": "listAvailableTimeSlots",
                "summary": "Check available appointment time slots",
                "description": "Use this tool after the visitor selects a service, branch and appointment date. Pass the selected serviceId, branchId and date. If the timeSlots array is non-empty, show every label to the visitor and have them pick one, then use the matching value as selectedTime for createAppointmentDeepLink. If timeSlots is empty, fall back to telling the visitor the availableSlotCount and timeRange. Never invent individual appointment times that are not present in the response.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "serviceId",
                                    "branchId",
                                    "selectedDate"
                                ],
                                "properties": {
                                    "serviceId": {
                                        "type": "string",
                                        "description": "The service ID returned by listServices."
                                    },
                                    "branchId": {
                                        "type": "string",
                                        "description": "The branch ID returned by listBranches."
                                    },
                                    "selectedDate": {
                                        "type": "string",
                                        "format": "date",
                                        "description": "The date value returned by listAvailableDates, in YYYY-MM-DD format."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Summary of time-slot availability",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "question": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "serviceId": {
                                            "type": "string"
                                        },
                                        "branchId": {
                                            "type": "string"
                                        },
                                        "selectedDate": {
                                            "type": "string",
                                            "format": "date"
                                        },
                                        "timeSlots": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "label": {
                                                        "type": "string"
                                                    },
                                                    "value": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "availableSlotCount": {
                                            "type": "integer",
                                            "nullable": true
                                        },
                                        "dateLabel": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "timeRange": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "hasAvailability": {
                                            "type": "boolean",
                                            "nullable": true
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}